# Model call demo
# Prefer copying a real .env from a previous phase, for example:
# cp ../../phase-3-frameworks/01-framework-basics/01-langgraph-deep-dive/.env .env

DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI-compatible alternatives:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_custom_key
# LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1

# Public MCP demo: Amap Maps
# Create a key from Amap Open Platform before running npm run demo:amap.
AMAP_MAPS_API_KEY=your_amap_maps_api_key_here
