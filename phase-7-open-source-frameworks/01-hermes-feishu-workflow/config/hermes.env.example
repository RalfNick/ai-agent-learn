# Copy this file to the private Hermes environment file on the VPS.
# Do not commit the filled version.

# Model provider. Pick one provider path and keep real credentials private.
OPENAI_API_KEY=<replace-with-openai-api-key>
OPENROUTER_API_KEY=<replace-with-openrouter-api-key>
NOUS_API_KEY=<replace-with-nous-api-key>

# Feishu / Lark bot.
FEISHU_APP_ID=<replace-with-feishu-app-id>
FEISHU_APP_SECRET=<replace-with-feishu-app-secret>
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket

# Access control. Use Feishu Open IDs such as ou_xxx.
FEISHU_ALLOWED_USERS=<replace-with-allowed-open-ids>
FEISHU_HOME_CHANNEL=<replace-with-home-chat-id>
FEISHU_GROUP_POLICY=allowlist
FEISHU_REQUIRE_MENTION=true
FEISHU_ALLOW_BOTS=none

# Keep YOLO unset in persistent gateway mode.
# HERMES_YOLO_MODE must not be set for this practice.
